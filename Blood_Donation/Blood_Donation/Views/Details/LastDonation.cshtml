@model List<Blood_Donation.EF.Tables.Donor>

<h2>Donors Sorted by Most Recent Donation Date</h2>

@if (Model.Count != 0)
{
    <table class="table table-bordered">
        <tr>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Last Donation Date</th>
        </tr>
        @foreach (var donor in Model)
        {
            <tr>
                <td>@donor.FullName</td>
                <td>@donor.BloodGroup</td>
                <td>@(donor.LastDonationDate.ToString("yyyy-MM-dd") ?? "Never donated")</td>
            </tr>
        }
    </table>
}
else
{
    <p>No data Found</p>
}