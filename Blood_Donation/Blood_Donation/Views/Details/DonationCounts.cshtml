@model IEnumerable<dynamic>
@using System.Linq

<h2>Total Donations per Donor</h2>

@if (Model.Count() != 0)
{
    <table class="table table-bordered">
        <tr>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Total Donations</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.BloodGroup</td>
                <td>@item.DonationCount</td>
            </tr>
        }
    </table>
}
else
{
    <p>No data Found</p>
}