<h2>Are you sure you want to delete this donor?</h2>
<h4>Name: @Model.FullName</h4>
<h4>Blood Group: @Model.BloodGroup</h4>
<h4>From: @Model.City</h4>

<form method="post">
    <input type="hidden" name="Id" value="@Model.DonorId" />
    <br />
    <input type="submit" name="Dcsn" value="Yes" class="btn btn-danger m-2" />
    <input type="submit" name="Dcsn" value="No" class="btn btn-success m-2" />
</form>
